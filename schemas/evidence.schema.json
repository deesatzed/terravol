{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:volterra:schema:EvidenceEvent:1",
  "title": "EvidenceEvent",
  "type": "object",
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability_basis": {
      "enum": [
        "live_observed",
        "certified_archive",
        "assumed_archive",
        "synthetic_fixture"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_uri": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "observed",
        "missing",
        "unavailable",
        "stale",
        "contradictory",
        "assumed"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "dependency_group": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes_revision_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "source_span",
        "supersedes_revision_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "evidence_id",
    "instrument_id",
    "event_time",
    "published_at",
    "available_at",
    "ingested_at",
    "availability_basis",
    "source_id",
    "source_uri",
    "content_sha256",
    "revision_id",
    "status",
    "unit",
    "value",
    "dependency_group",
    "synthetic",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "missing",
              "unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    }
  ]
}
