{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:volterra:schema:GraphSpec:1",
  "title": "GraphSpec",
  "type": "object",
  "properties": {
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "prior_version": {
      "type": "string",
      "minLength": 1
    },
    "domain_adapter": {
      "type": "string",
      "minLength": 1
    },
    "rule_set_version": {
      "type": "string",
      "minLength": 1
    },
    "inference_backend": {
      "type": "string",
      "minLength": 1
    },
    "approved_function_registry": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "causal_status": {
      "enum": [
        "predictive_associations",
        "assumed_structural",
        "identified_structural"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "observation",
              "parameter",
              "latent",
              "target",
              "deterministic"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "support": {
            "type": "object",
            "properties": {
              "lower": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "upper": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "lower",
              "upper"
            ],
            "additionalProperties": false
          },
          "distribution": {
            "type": "object",
            "properties": {
              "family": {
                "enum": [
                  "normal",
                  "lognormal",
                  "gamma",
                  "beta",
                  "bernoulli",
                  "student_t",
                  "categorical",
                  "dirichlet",
                  "deterministic"
                ]
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "node_ref": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "node_ref"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "family",
              "parameters"
            ],
            "additionalProperties": false
          },
          "prior_provenance": {
            "type": "string",
            "minLength": 1
          },
          "numeric_origin": {
            "enum": [
              "fitted_past_data",
              "external_estimate",
              "expert_assumed",
              "synthetic_fixture"
            ]
          },
          "observation_status": {
            "enum": [
              "observed",
              "latent",
              "assumed",
              "not_applicable"
            ]
          },
          "editable": {
            "type": "boolean"
          },
          "function_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "node_id",
          "role",
          "unit",
          "support",
          "distribution",
          "prior_provenance",
          "numeric_origin",
          "observation_status",
          "editable",
          "function_id"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "lag_sessions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "source",
          "target",
          "lag_sessions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "graph_id",
    "version",
    "prior_version",
    "domain_adapter",
    "rule_set_version",
    "inference_backend",
    "approved_function_registry",
    "causal_status",
    "synthetic",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
